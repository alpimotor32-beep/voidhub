-- 5. ESP / Highlight Semua Benda & Elemen di Map
local EspBtn = Instance.new("TextButton")
EspBtn.Parent = ScrollContainer
EspBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
EspBtn.Position = UDim2.new(0, 0, 0, 210)
EspBtn.Size = UDim2.new(0, 310, 0, 40)
EspBtn.Font = Enum.Font.GothamBold
EspBtn.Text = "ESP / Highlight Benda & Ide: [OFF]"
EspBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
EspBtn.TextSize = 12
Instance.new("UICorner", EspBtn).CornerRadius = UDim.new(0, 6)

local espFolder = Instance.new("Folder")
espFolder.Name = "IdeasESP"
espFolder.Parent = CoreGui
local espOn = false

EspBtn.MouseButton1Click:Connect(function`()
    espOn = not espOn
    if espOn then
        EspBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        EspBtn.Text = "ESP / Highlight Benda & Ide: [ON]"
        task.spawn(function()
            while espOn do
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and not obj:FindFirstChild("Highlight") then
                        local hl = Instance.new("Highlight")
                        hl.Parent = obj
                        hl.FillColor = Color3.fromRGB(255, 255, 0)
                    end
                end
                task.wait(4)
            end
        end)
    else
        EspBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        EspBtn.Text = "ESP / Highlight Benda & Ide: [OFF]"
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local hl = obj:FindFirstChildOfClass("Highlight")
                if hl then hl:Destroy() end
            end
        end
    end
end)

