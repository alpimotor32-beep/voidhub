SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", SpeedBtn).CornerRadius = UDim.new(0, 6)

local speedOn = false
SpeedBtn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    if speedOn then
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        SpeedBtn.Text = "Speed Hack (35): [ON]"
        if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
            localPlayer.Character.Humanoid.WalkSpeed = 35
        end
    else
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        SpeedBtn.Text = "Speed Hack (35): [OFF]"
        if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
            localPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

